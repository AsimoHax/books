<h1>Book Keeping - 23IT284</h1>

<form action="/books" method="POST">
    <div>
        <label>Product Code:</label>
        <input type="text" name="productCode" required>
    </div>

    <div>
        <label>Book Name:</label>
        <input type="text" name="name" required>
    </div>

    <div>
        <label>Price:</label>
        <input type="number" id="price" name="price" min="1" required>
    </div>

    <div>
        <label>VAT:</label>
        <input type="text" value="{{vat}}%" readonly>
    </div>

    <div>
        <label>Price After Tax:</label>
        <input type="text" id="priceAfterTax" readonly>
    </div>

    <button type="submit">Add Book</button>
</form>

<hr>

<h2>Books</h2>

{{#each books}}
    <div>
        <p>Product Code: {{productCode}}</p>
        <p>Name: {{name}}</p>
        <p>Price After Tax: {{priceAfterTax}}</p>
    </div>
    <hr>
{{/each}}

<script>
    const priceInput = document.getElementById("price");
    const priceAfterTaxInput = document.getElementById("priceAfterTax");

    const vat = {{vat}} / 100;

    priceInput.addEventListener("input", () => {
        const price = Number(priceInput.value);

        if (price > 0) {
            const priceAfterTax = price * (1 + vat);
            priceAfterTaxInput.value = priceAfterTax;
        } else {
            priceAfterTaxInput.value = "";
        }
    });
</script>   